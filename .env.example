# Copy to .env and fill in. Never commit .env.

# --- Postgres (used by docker compose) ---
# Use a URL-safe password (letters, digits, - _ . ~): it is embedded in DATABASE_URL.
POSTGRES_USER=domora_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=domora

# --- Edge (Caddy) ---
# ":80" serves plain HTTP on the server IP (beta stage).
# Use a domain name (e.g. app.example.com) to enable automatic HTTPS.
APP_DOMAIN=:80

# --- App ---
# Leave empty to detect HTTP/HTTPS from the proxy (X-Forwarded-Proto).
# Force with "true" or "false" if needed.
COOKIE_SECURE=

# Notification driver for the worker. "console" (default) logs and sends
# nothing. Use "resend" only once a sending domain is verified in Resend (EU
# region); keep "console" in the HTTP-on-IP stage.
NOTIFIER_DRIVER=console
# Required only when NOTIFIER_DRIVER=resend.
# RESEND_API_KEY=
# Sender on the verified domain, e.g. "DOMORA <no-reply@your-domain.example>".
# NOTIFIER_FROM=

# --- Local development only (npm run dev, db:migrate, db:seed) ---
# Compose builds DATABASE_URL for its containers itself; do not set it there.
DATABASE_URL=postgresql://domora_user:change-me@localhost:5432/domora

# --- First admin bootstrap (db:seed only; see README "First admin and seed data") ---
# All four are required together. Password: at least 12 characters.
# Remove them from your shell/env after the first run.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PHONE=
# ADMIN_PASSWORD=
