# Copy to .env and fill in. Never commit .env.

# --- Postgres (used by docker compose) ---
# Use a URL-safe password (letters, digits, - _ . ~): it is embedded in DATABASE_URL.
POSTGRES_USER=domora_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=domora

# --- Edge (Caddy) ---
# ":80" serves plain HTTP on the server IP (beta stage).
# Use a domain name (e.g. app.example.com) to enable automatic HTTPS.
APP_DOMAIN=:80

# --- App ---
# Leave empty to detect HTTP/HTTPS from the proxy (X-Forwarded-Proto).
# Force with "true" or "false" if needed.
COOKIE_SECURE=

# --- Local development only (npm run dev, db:migrate, db:seed) ---
# Compose builds DATABASE_URL for its containers itself; do not set it there.
DATABASE_URL=postgresql://domora_user:change-me@localhost:5432/domora
